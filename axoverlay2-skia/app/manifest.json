{
    "schemaVersion": "2.2.0",
    "resources": {
        "overlay": {
            "enabled": true,
            "required": true
        },
        "linux": {
            "user": {
                "groups": ["gpu"]
            }
        }
    },
    "acapPackageConf": {
        "setup": {
            "friendlyName": "Axoverlay2 example Skia application",
            "appName": "axoverlay2_skia",
            "vendor": "Axis Communications",
            "vendorId": "0123456789",
            "vendorUrl": "https://www.axis.com",
            "runMode": "never",
            "version": "1.0.0",
            "compatibleOsVersions": [
                {
                    "max": "13"
                }
            ]
        }
    }
}
