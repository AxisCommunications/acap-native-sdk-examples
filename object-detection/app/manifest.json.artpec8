{
    "schemaVersion": "2.3.0",
    "resources": {
        "linux": {
            "user": {
                "groups": ["video"]
            }
        },
        "deepLearningProcessor": {
            "enabled": true,
            "required": true
        }
    },
    "acapPackageConf": {
        "setup": {
            "friendlyName": "object_detection_artpec8",
            "appName": "object_detection",
            "vendor": "Axis Communications",
            "vendorId": "12345abcde",
            "runOptions": "model/converted_model.tflite 50 label/labels.txt -d axis-a8-dlpu-tflite",
            "vendorUrl": "https://www.axis.com",
            "runMode": "never",
            "version": "1.0.0",
            "compatibleOsVersions": [
                {
                    "max": "13"
                }
            ]
        }
    }
}
