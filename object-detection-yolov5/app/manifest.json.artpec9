{
    "schemaVersion": "2.3.0",
    "resources": {
        "dbus": {
            "requiredMethods": [
                "com.axis.Graphics2.*",
                "com.axis.Overlay2.*"
            ]
        },
        "linux": {
            "user": {
                "groups": ["video"]
            }
        },
        "deepLearningProcessor": {
            "enabled": true,
            "required": true
        }
    },
    "acapPackageConf": {
        "setup": {
            "friendlyName": "object_detection_yolov5_artpec9",
            "appName": "object_detection_yolov5",
            "vendor": "Axis Communications",
            "vendorId": "12345abcde",
            "runOptions": "model/model.tflite label/labels.txt -c a9-dlpu-tflite",
            "vendorUrl": "https://www.axis.com",
            "runMode": "never",
            "version": "1.0.0",
            "compatibleOsVersions": [
                {
                    "max": "13"
                }
            ]
        },
        "configuration": {
            "paramConfig": [
                {
                    "name": "ConfThresholdPercent",
                    "default": "25",
                    "type": "int:maxlen=3;min=0;max=100"
                },
                {
                    "name": "IouThresholdPercent",
                    "default": "5",
                    "type": "int:maxlen=3;min=0;max=100"
                }
            ]
        }
    }
}
